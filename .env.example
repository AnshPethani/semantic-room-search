# Copy to .env at the repository root and fill in. Never commit .env.
# The CLI and load_config() read it automatically; no "export" step is needed.
# A variable already set in your shell takes precedence over this file.
# Format: NAME=value (optional "export " prefix, optional quotes, # comments).
GEMINI_API_KEY=your-key-here
# Exact model ID copied from Google AI Studio (config setting, not hardcoded in code).
GEMINI_MODEL=your-model-name-here
