<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lang_grounding_ros</name>
  <version>0.1.0</version>
  <description>Thin ROS 2 wrapper that serves the lang_grounding library as the /ground_command service.</description>
  <maintainer email="ansh@todo.edu">Ansh Pethani</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>semantic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
